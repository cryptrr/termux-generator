@@ -8,6 +8,38 @@ termux_download() {
 	local URL="$1"
 	local DESTINATION="$2"
 	local CHECKSUM="${3:-SKIP_CHECKSUM}"
+	local -a URLS=("$URL")
+	if [[ "$URL" == "${TERMUX_PKG_SRCURL-}" ]] && \
+			declare -p TERMUX_PKG_SRCURL_FALLBACKS &>/dev/null; then
+		URLS+=("${TERMUX_PKG_SRCURL_FALLBACKS[@]}")
+	fi
+
+	# Public GNU download endpoints occasionally return transient gateway errors.
+	# Keep package recipes authoritative, but try an equivalent mirror after the
+	# recipe URL and its normal retries have been exhausted.
+	case "$URL" in
+		https://ftpmirror.gnu.org/gnu/*)
+			URLS+=("https://ftp.gnu.org/gnu/${URL#https://ftpmirror.gnu.org/gnu/}")
+			;;
+		https://ftpmirror.gnu.org/*)
+			URLS+=("https://ftp.gnu.org/gnu/${URL#https://ftpmirror.gnu.org/}")
+			;;
+		https://ftp.gnu.org/gnu/*|http://ftp.gnu.org/gnu/*)
+			URLS+=("https://ftpmirror.gnu.org/${URL#*://ftp.gnu.org/gnu/}")
+			;;
+		https://www.gnu.org/software/*|http://www.gnu.org/software/*)
+			URLS+=("https://ftp.gnu.org/gnu/${URL#*://www.gnu.org/software/}")
+			;;
+		https://download.savannah.gnu.org/releases/*|http://download.savannah.gnu.org/releases/*)
+			URLS+=("http://download-mirror.savannah.gnu.org/releases/${URL#*://download.savannah.gnu.org/releases/}")
+			;;
+		https://download-mirror.savannah.gnu.org/releases/*|http://download-mirror.savannah.gnu.org/releases/*)
+			URLS+=("https://download.savannah.gnu.org/releases/${URL#*://download-mirror.savannah.gnu.org/releases/}")
+			;;
+		http://codeberg.org/*)
+			URLS+=("https://codeberg.org/${URL#http://codeberg.org/}")
+			;;
+	esac
 
 	if [[ "$URL" =~ ^file://(/[^/]+)+$ ]]; then
 		local source="${URL:7}" # Remove `file://` prefix
@@ -51,40 +83,47 @@ termux_download() {
 		CURL_OPTIONS+=(--no-progress-meter) # Don't print out transfer statistics
 	fi
 
