+	local candidate
+	for candidate in "${URLS[@]}"; do
+		echo "Downloading ${candidate}"
+		local error=0
+		if ! curl "${CURL_OPTIONS[@]}" --output "$TMPFILE" "$candidate"; then
+			error=1
+			local retry=2
+			local delay=60
+			local try
+			for (( try=1; try <= retry; try++ )); do
+				echo "Retrying #${try} download ${candidate} in ${delay}"
+				sleep "${delay}"
+				if curl "${CURL_OPTIONS[@]}" --output "$TMPFILE" "$candidate"; then
+					error=0
+					break
+				fi
+			done
+		fi
+		if [[ "$error" != 0 ]]; then
+			echo "Failed to download $candidate" 1>&2
